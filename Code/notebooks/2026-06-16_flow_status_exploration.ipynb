    "def classify_river_segments_by_buffer_with_connection(\n",
    "    rivers_region,\n",
    "    flow_status,\n",
    "    agg_transform,\n",
    "    buffer_m=5000,\n",
    "    endpoint_radius_cells=5,\n",
    "    tie_rule=\"perennial\"\n",
    "):\n",
    "    \"\"\"\n",
    "    娌虫鍒嗙被閫昏緫锛歕n",
    "\n",
    "    1. 鍏堢湅璇ユ渤娈?buffer 鍐呮槸鍚﹀瓨鍦ㄨ疮閫氶灏剧殑闈炴柇娴佽摑鑹茶繛閫氬垎閲忋€俓n",
    "       濡傛灉鏈夛紝鐩存帴鍒や负闈炴柇娴併€俓n",
    "\n",
    "    2. 濡傛灉娌℃湁璐€氱殑钃濊壊杩為€氬垎閲忥紝\n",
    "       鍐嶇敤鏂祦鏍煎瓙鍜岄潪鏂祦鏍煎瓙鐨勫鏁版姇绁ㄥ垽鏂€俓n",
    "    \"\"\"\n",
    "\n",
    "    rivers_classified = rivers_region.copy().reset_index(drop=True)\n",
    "\n",
    "    if len(rivers_classified) == 0:\n",
    "        print(\"No river segments in this region.\")\n",
    "        return rivers_classified\n",
    "\n",
    "    if rivers_classified.crs is None:\n",
    "        raise ValueError(\"rivers_region 娌℃湁 CRS锛岃鍏堣缃?CRS銆俓")\n",
    "\n",
    "    if rivers_classified.crs.to_string() != \"EPSG:4326\":\n",
    "        rivers_classified = rivers_classified.to_crs(\"EPSG:4326\")\n",
    "\n",
    "    # 鐢ㄦ姇褰卞潗鏍囩郴鍋?buffer锛屽崟浣嶆槸 m\n",
    "    try:\n",
    "        metric_crs = rivers_classified.estimate_utm_crs()\n",
    "    except Exception:\n",
    "        metric_crs = \"EPSG:32650\"\n",
    "\n",
    "    rivers_metric = rivers_classified.to_crs(metric_crs)\n",
    "\n",
    "    buffers_metric = rivers_metric.geometry.buffer(buffer_m)\n",
    "\n",
    "    buffers_lonlat = gpd.GeoSeries(\n",
    "        buffers_metric,\n",
    "        crs=metric_crs\n",
    "    ).to_crs(\"EPSG:4326\")\n",
    "\n",
    "    intermittent_counts = []\n",
    "    perennial_counts = []\n",
    "    water_counts = []\n",
    "    perennial_ratios = []\n",
    "    connected_flags = []\n",
    "    segment_statuses = []\n",
    "    segment_labels = []\n",
    "\n",
    "    height, width = flow_status.shape\n",
    "\n",
    "    for geom, buffer_geom in zip(rivers_classified.geometry, buffers_lonlat):\n",
    "\n",
    "        buffer_mask = geometry_mask(\n",
    "            [buffer_geom],\n",
    "            out_shape=(height, width),\n",
    "            transform=agg_transform,\n",
    "            invert=True,\n",
    "            all_touched=True\n",
    "        )\n",
    "\n",
    "        intermittent_count = np.sum((flow_status == 1) & buffer_mask)\n",
    "        perennial_count = np.sum((flow_status == 2) & buffer_mask)\n",
    "        water_count = intermittent_count + perennial_count\n",
    "\n",
    "        if water_count == 0:\n",
    "            segment_status = np.nan\n",
    "            segment_label = \"No water grid\"\n",
    "            perennial_ratio = np.nan\n",
    "            connected_perennial = False\n",
    "\n",
    "        else:\n",
    "            perennial_ratio = perennial_count / water_count\n",
    "\n",
    "            # 鍏抽敭鏂板鏉′欢锛歕n",
    "            # 濡傛灉闈炴柇娴佹牸瀛愬彲浠ヤ粠娌虫澶磋繛鍒版渤娈靛熬锛岀洿鎺ュ垽涓洪潪鏂祦\n",
    "            connected_perennial = has_perennial_connection_from_start_to_end(\n",
    "                geom=geom,\n",
    "                flow_status=flow_status,\n",
    "                buffer_mask=buffer_mask,\n",
    "                agg_transform=agg_transform,\n",
    "                endpoint_radius_cells=endpoint_radius_cells,\n",
    "                min_component_cells=2\n",
    "            )\n",
    "\n",
    "            if connected_perennial:\n",
    "                segment_status = 2\n",
    "                segment_label = \"Perennial_connected\"\n",
    "\n",
    "            else:\n",
    "                majority_perennial_threshold = 0.7\n",
    "\n",
    "                if perennial_ratio >= majority_perennial_threshold:\n",
    "                    segment_status = 2\n",
    "                    segment_label = \"Perennial_ratio\"\n",
    "\n",
    "                else:\n",
    "                    segment_status = 1\n",
    "                    segment_label = \"Intermittent_ratio\"\n",
    "\n",
    "        intermittent_counts.append(intermittent_count)\n",
    "        perennial_counts.append(perennial_count)\n",
    "        water_counts.append(water_count)\n",
    "        perennial_ratios.append(perennial_ratio)\n",
    "        connected_flags.append(connected_perennial)\n",
    "        segment_statuses.append(segment_status)\n",
    "        segment_labels.append(segment_label)\n",
    "\n",
    "    rivers_classified[\"intermittent_count\"] = intermittent_counts\n",
    "    rivers_classified[\"perennial_count\"] = perennial_counts\n",
    "    rivers_classified[\"water_count\"] = water_counts\n",
    "    rivers_classified[\"perennial_ratio\"] = perennial_ratios\n",
    "    rivers_classified[\"connected_perennial\"] = connected_flags\n",
    "    rivers_classified[\"segment_status\"] = segment_statuses\n",
    "    rivers_classified[\"segment_label\"] = segment_labels\n",
    "\n",
    "    return rivers_classified"
   ]
  },
