    "from matplotlib.colors import ListedColormap, BoundaryNorm\n",
    "import matplotlib.patches as mpatches\n",
    "from matplotlib.lines import Line2D\n",
    "from shapely.geometry import box\n",
    "import geopandas as gpd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# =========================\n",
    "# 1. 纭 CRS\n",
    "# =========================\n",
    "\n",
    "print(\"Rivers CRS:\", rivers.crs)\n",
    "\n",
    "# HydroRIVERS 閫氬父鏄?EPSG:4326锛岀粡绾害\n",
    "# 濡傛灉涓嶆槸 EPSG:4326锛屽氨杞垚 EPSG:4326\n",
    "if rivers.crs != \"EPSG:4326\":\n",
    "    rivers_plot = rivers.to_crs(\"EPSG:4326\")\n",
    "else:\n",
    "    rivers_plot = rivers.copy()\n",
    "\n",
    "# =========================\n",
    "# 2. 閫夋嫨澶ф渤锛屽苟瑁佸壀鍒扮爺绌跺尯鍩焅n",
    "# =========================\n",
    "\n",
    "large_rivers = rivers_plot[\n",
    "    rivers_plot[\"DIS_AV_CMS\"] >= 40\n",
    "].copy()\n",
    "\n",
    "region_gdf = gpd.GeoDataFrame(\n",
    "    geometry=[box(lon_min, lat_min, lon_max, lat_max)],\n",
    "    crs=\"EPSG:4326\"\n",
    ")\n",
    "\n",
    "# 姣?intersects 鏇撮€傚悎鐢诲浘锛屽洜涓?clip 浼氱湡鐨勫垏鎺夊尯鍩熷鐨勭嚎娈礬n",
    "rivers_region = gpd.clip(large_rivers, region_gdf)\n",
    "\n",
    "print(\"Number of selected river segments:\", len(rivers_region))\n",
    "# =========================\n",
