    "from rasterio.features import geometry_mask\n",
    "from rasterio.transform import rowcol\n",
    "from scipy.ndimage import label\n",
    "import geopandas as gpd\n",
    "import numpy as np\n",
    "from shapely.geometry import LineString, MultiLineString\n",
    "\n",
    "\n",
    "def get_main_linestring(geom):\n",
    "    \"\"\"\n",
    "    濡傛灉鏄?LineString锛岀洿鎺ヨ繑鍥炪€俓n",
    "    濡傛灉鏄?MultiLineString锛屽彇鏈€闀跨殑涓€娈点€俓n",
    "    \"\"\"\n",
    "    if geom is None or geom.is_empty:\n",
    "        return None\n",
    "\n",
    "    if geom.geom_type == \"LineString\":\n",
    "        return geom\n",
    "\n",
    "    if geom.geom_type == \"MultiLineString\":\n",
    "        lines = list(geom.geoms)\n",
    "        if len(lines) == 0:\n",
    "            return None\n",
    "        return max(lines, key=lambda x: x.length)\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def endpoint_neighborhood_mask(\n",
    "    point_xy,\n",
    "    shape,\n",
    "    transform,\n",
    "    radius_cells=5\n",
    "):\n",
    "    \"\"\"\n",
    "    缁欐渤娈电鐐圭敓鎴愪竴涓儚鍏冮偦鍩?mask銆俓n",
    "    radius_cells=5 琛ㄧず绔偣鍛ㄥ洿 5 涓牸瀛愮殑鑼冨洿銆俓n",
    "    \"\"\"\n",
    "    height, width = shape\n",
    "    x, y = point_xy\n",
    "\n",
    "    try:\n",
    "        r, c = rowcol(transform, x, y)\n",
    "    except Exception:\n",
    "        return np.zeros(shape, dtype=bool)\n",
    "\n",
    "    mask = np.zeros(shape, dtype=bool)\n",
    "\n",
    "    r0 = max(0, r - radius_cells)\n",
    "    r1 = min(height, r + radius_cells + 1)\n",
    "    c0 = max(0, c - radius_cells)\n",
    "    c1 = min(width, c + radius_cells + 1)\n",
    "\n",
    "    mask[r0:r1, c0:c1] = True\n",
    "\n",
    "    return mask\n",
    "\n",
    "\n",
    "def has_perennial_connection_from_start_to_end(\n",
    "    geom,\n",
    "    flow_status,\n",
    "    buffer_mask,\n",
    "    agg_transform,\n",
    "    endpoint_radius_cells=5,\n",
    "    min_component_cells=2\n",
    "):\n",
    "    \"\"\"\n",
    "    鍒ゆ柇鏌愭潯娌虫 buffer 鍐咃紝鏄惁瀛樺湪涓€涓摑鑹叉牸瀛愯繛閫氬垎閲忥紝\n",
    "    鍙互浠庢渤娈佃捣鐐归檮杩戣繛鍒扮粓鐐归檮杩戙€俓n",
    "\n",
    "    flow_status:\n",
    "    0 = non-water\n",
    "    1 = intermittent / 鏂祦\n",
    "    2 = perennial / 闈炴柇娴乗n",
    "    \"\"\"\n",
    "\n",
    "    line = get_main_linestring(geom)\n",
    "    if line is None:\n",
    "        return False\n",
    "\n",
    "    coords = list(line.coords)\n",
    "    if len(coords) < 2:\n",
    "        return False\n",
    "\n",
    "    start_xy = coords[0]\n",
    "    end_xy = coords[-1]\n",
    "\n",
    "    # 鍙湅褰撳墠娌虫 buffer 鍐呯殑闈炴柇娴佹牸瀛怽n",
    "    perennial_mask = (flow_status == 2) & buffer_mask\n",
    "\n",
    "    if perennial_mask.sum() < min_component_cells:\n",
    "        return False\n",
    "\n",
    "    # 8閭诲煙杩為€歕n",
    "    structure = np.ones((3, 3), dtype=int)\n",
    "    labeled, num_features = label(perennial_mask, structure=structure)\n",
    "\n",
    "    if num_features == 0:\n",
    "        return False\n",
    "\n",
    "    start_mask = endpoint_neighborhood_mask(\n",
    "        start_xy,\n",
    "        flow_status.shape,\n",
    "        agg_transform,\n",
    "        radius_cells=endpoint_radius_cells\n",
    "    )\n",
    "\n",
    "    end_mask = endpoint_neighborhood_mask(\n",
    "        end_xy,\n",
    "        flow_status.shape,\n",
    "        agg_transform,\n",
    "        radius_cells=endpoint_radius_cells\n",
    "    )\n",
    "\n",
    "    # 鍙鏌ュ悓鏃舵帴瑙﹁捣鐐归檮杩戝拰缁堢偣闄勮繎鐨勮繛閫氬垎閲廫n",
    "    for comp_id in range(1, num_features + 1):\n",
    "        comp = labeled == comp_id\n",
    "\n",
    "        if comp.sum() < min_component_cells:\n",
    "            continue\n",
    "\n",
    "        touches_start = np.any(comp & start_mask)\n",
    "        touches_end = np.any(comp & end_mask)\n",
    "\n",
    "        if touches_start and touches_end:\n",
    "            return True\n",
    "\n",
    "    return False"
   ]
  },
