    "    loc=\"upper right\",\n",
    "    title=\"Legend\"\n",
    ")\n",
    "\n",
    "ax.set_xlim(lon_min, lon_max)\n",
    "ax.set_ylim(lat_min, lat_max)\n",
    "\n",
    "ax.set_title(\n",
