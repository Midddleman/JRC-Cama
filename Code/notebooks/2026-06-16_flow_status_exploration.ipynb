    "def aggregate_perennial_status(season, water_agg, factor=33, perennial_threshold=10, ratio_threshold=0.5):\n",
    "    \"\"\"\n",
    "    杈撳嚭鍒嗙被锛歕n",
    "    0 = non-water\n",
    "    1 = intermittent / 鏂祦\n",
    "    2 = perennial / 闈炴柇娴乗n",
    "\n",
    "    鍒ゅ畾閫昏緫锛歕n",
    "    - 鍘熷鍍忓厓 season > 0 璁や负鏄?water pixel\n",
    "    - 鍘熷鍍忓厓 season >= perennial_threshold 璁や负鏄?perennial pixel\n",
    "    - 瀵规瘡涓仛鍚堝悗鐨?water grid锛歕n",
    "        perennial pixels / water pixels > ratio_threshold\n",
    "        鍒欏垽瀹氫负闈炴柇娴乗n",
    "    \"\"\"\n",
    "\n",
    "    height, width = season.shape\n",
    "\n",
    "    new_height = math.ceil(height / factor) * factor\n",
    "    new_width = math.ceil(width / factor) * factor\n",
    "\n",
    "    padded = np.full((new_height, new_width), np.nan, dtype=\"float32\")\n",
    "    padded[:height, :width] = season\n",
    "\n",
    "    valid = ~np.isnan(padded)\n",
    "\n",
    "    # 鏈夋按鍍忓厓\n",
    "    water_pixel = (padded > 0) & valid\n",
    "\n",
    "    # 闈炴柇娴佸儚鍏冿細涓€骞翠腑鑷冲皯 10 涓湀鏈夋按\n",
    "    perennial_pixel = (padded >= perennial_threshold) & valid\n",
    "\n",
    "    block_h = new_height // factor\n",
    "    block_w = new_width // factor\n",
    "\n",
    "    water_blocks = water_pixel.reshape(block_h, factor, block_w, factor)\n",
    "    perennial_blocks = perennial_pixel.reshape(block_h, factor, block_w, factor)\n",
    "\n",
    "    water_count = water_blocks.sum(axis=(1, 3))\n",
    "    perennial_count = perennial_blocks.sum(axis=(1, 3))\n",
    "\n",
    "    perennial_ratio = np.divide(\n",
    "        perennial_count,\n",
    "        water_count,\n",
    "        out=np.zeros_like(perennial_count, dtype=\"float32\"),\n",
    "        where=water_count > 0\n",
    "    )\n",
    "\n",
    "    # 0 = non-water\n",
    "    # 1 = intermittent / 鏂祦\n",
    "    # 2 = perennial / 闈炴柇娴乗n",
    "    status = np.zeros_like(water_agg, dtype=\"uint8\")\n",
    "\n",
    "    # 鍏堟妸鎵€鏈夋按鏍煎瓙璁句负鏂祦\n",
    "    status[water_agg == 1] = 1\n",
    "\n",
    "    # 鍦ㄦ按鏍煎瓙涓紝濡傛灉 perennial_ratio > 0.5锛屽垯璁句负闈炴柇娴乗n",
    "    status[(water_agg == 1) & (perennial_ratio > ratio_threshold)] = 2\n",
    "\n",
    "    return status, perennial_ratio, water_count, perennial_count"
   ]
  },
