    "def aggregate_water_binary(season, factor=33, threshold=0.5):\n",
    "    height, width = season.shape\n",
    "\n",
    "    # 涓轰簡鑳芥暣闄?factor锛屽厛 padding 鍒?factor 鐨勬暣鏁板€峔n",
    "    new_height = math.ceil(height / factor) * factor\n",
    "    new_width = math.ceil(width / factor) * factor\n",
    "\n",
    "    padded = np.full((new_height, new_width), np.nan, dtype=\"float32\")\n",
    "    padded[:height, :width] = season\n",
    "\n",
    "    # 鏈夋晥鏍肩偣锛屼笉鏄?NaN\n",
    "    valid = ~np.isnan(padded)\n",
    "\n",
    "    # 姘存牸鐐癸細seasonality > 0\n",
    "    water = (padded > 0) & valid\n",
    "\n",
    "    # reshape 鎴?block\n",
    "    block_h = new_height // factor\n",
    "    block_w = new_width // factor\n",
    "\n",
    "    valid_blocks = valid.reshape(block_h, factor, block_w, factor)\n",
    "    water_blocks = water.reshape(block_h, factor, block_w, factor)\n",
    "\n",
    "    valid_count = valid_blocks.sum(axis=(1, 3))\n",
    "    water_count = water_blocks.sum(axis=(1, 3))\n",
    "\n",
    "    # 姘存瘮渚媆n",
    "    water_ratio = np.divide(\n",
    "        water_count,\n",
    "        valid_count,\n",
    "        out=np.zeros_like(water_count, dtype=\"float32\"),\n",
    "        where=valid_count > 0\n",
    "    )\n",
    "\n",
    "    # 鑱氬悎鍚庣殑浜屽€煎浘鍍廫n",
    "    # 1 = water\n",
    "    # 0 = non-water\n",
    "    water_binary = (water_ratio > threshold).astype(\"uint8\")\n",
    "\n",
    "    return water_binary, water_ratio, valid_count\n",
    "\n",
    "\n",
    "water_agg, water_ratio, valid_count = aggregate_water_binary(\n",
    "    season,\n",
    "    factor=factor,\n",
    "    threshold=water_ratio_threshold\n",
    ")\n",
    "\n",
    "print(\"Aggregated shape:\", water_agg.shape)\n",
    "print(\"Aggregated unique values:\", np.unique(water_agg))\n",
    "print(\"Water grid count:\", np.sum(water_agg == 1))\n",
    "print(\"Non-water grid count:\", np.sum(water_agg == 0))"
   ]
  },
