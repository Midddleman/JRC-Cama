    "import matplotlib.patches as mpatches\n",
    "# 鑱氬悎鍚庣殑 transform\n",
    "agg_transform = season_transform * Affine.scale(factor, factor)\n",
    "\n",
    "# 璁＄畻鑱氬悎鍥惧儚鐨勭湡瀹炴樉绀鸿寖鍥碶n",
    "height_agg, width_agg = water_agg.shape\n",
    "\n",
    "west = agg_transform.c\n",
    "north = agg_transform.f\n",
    "east = west + agg_transform.a * width_agg\n",
    "south = north + agg_transform.e * height_agg\n",
    "\n",
    "extent_agg = [west, east, south, north]\n",
    "\n",
    "plt.figure(figsize=(8, 8))\n",
    "\n",
    "water_binary_cmap = plt.get_cmap(\"gray_r\", 2)\n",
    "water_binary_norm = mcolors.BoundaryNorm([-0.5, 0.5, 1.5], water_binary_cmap.N)\n",
    "\n",
    "im = plt.imshow(\n",
    "    water_agg,\n",
    "    extent=extent_agg,\n",
    "    origin=\"upper\",\n",
    "    cmap=water_binary_cmap,\n",
    "    norm=water_binary_norm\n",
    ")\n",
